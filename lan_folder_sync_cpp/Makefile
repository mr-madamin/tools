CXX      ?= c++
CXXFLAGS ?= -std=c++23 -O2 -Wall -Wextra -Wpedantic -D_DARWIN_C_SOURCE
LDFLAGS  ?=

# Let the compiler record which headers each object used, and feed those back
# in as rules. Without this, editing framing.hpp rebuilds NOTHING: make only
# knows about the .cpp files, so `make check` can pass against stale objects
# that don't contain the change under test.
DEPFLAGS := -MMD -MP

BIN     := bin
SRC     := src
TESTDIR := tests

LIB_SRC := $(SRC)/util.cpp $(SRC)/json.cpp $(SRC)/paths.cpp $(SRC)/config.cpp \
           $(SRC)/socket.cpp $(SRC)/framing.cpp $(SRC)/manifest.cpp $(SRC)/server.cpp
LIB_OBJ := $(LIB_SRC:$(SRC)/%.cpp=$(BIN)/%.o)

PROGS     := sync_server sync_push file_sender file_receiver
TEST_SRC  := $(wildcard $(TESTDIR)/*.cpp)
TEST_OBJ  := $(TEST_SRC:$(TESTDIR)/%.cpp=$(BIN)/test_%.o)

all: $(PROGS:%=$(BIN)/%)

$(BIN):
	@mkdir -p $(BIN)

$(BIN)/%.o: $(SRC)/%.cpp | $(BIN)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

$(BIN)/test_%.o: $(TESTDIR)/%.cpp | $(BIN)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -I$(SRC) -c $< -o $@

$(BIN)/%: $(BIN)/%.o $(LIB_OBJ)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)

# One binary for the whole suite: the tests run real sessions in-process, so
# there is nothing to start and nothing to tear down.
$(BIN)/tests: $(TEST_OBJ) $(LIB_OBJ)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)

tests: $(BIN)/tests

test: $(BIN)/tests
	@./$(BIN)/tests

# ---- interop ---------------------------------------------------------------
#
# The sibling ports. Their runners dial 127.0.0.1:8765, so a server started
# from here must be the only thing on that port while they run.
PY_DIR := ../lan_folder_sync
C_DIR  := ../lan_folder_sync_c
PORT   := 8765
LOGS   := $(BIN)/test-logs

PY_TESTS := hello_test bad_frame_test atomic_test dry_run_test delete_test nasty_test
C_TESTS  := hello_test bad_frame_test dry_run_test delete_test atomic_test partial_test

# Refuse to start if something already holds the port: the runners would
# silently test THAT server instead of this one.
port-free:
	@if lsof -nP -iTCP:$(PORT) -sTCP:LISTEN >/dev/null 2>&1; then \
	  echo "port $(PORT) is in use -- stop the server holding it first"; exit 1; fi

# The Python suite against the C++ server. The server takes its token from the
# Python config, but serves the Python sandbox EXPLICITLY: that config.json may
# point shared_dir at a real folder, and a test must never plant files there.
interop-python: all port-free
	@set -e; \
	mkdir -p $(PY_DIR)/sandbox/source $(PY_DIR)/sandbox/received $(LOGS); \
	LAN_FOLDER_SYNC_CONFIG=$(PY_DIR)/config.json \
	  ./$(BIN)/sync_server $(abspath $(PY_DIR))/sandbox/received $(PORT) > $(LOGS)/py-server.log 2>&1 & \
	SRV=$$!; trap "kill $$SRV 2>/dev/null || true" EXIT INT TERM; sleep 1; \
	fail=0; \
	for t in $(PY_TESTS); do \
	  printf '  python %-16s ' $$t; \
	  if (cd $(PY_DIR) && python3 -m tests.$$t) > $(LOGS)/py-$$t.log 2>&1; then echo PASS; \
	  else echo FAIL; fail=1; sed 's/^/      /' $(LOGS)/py-$$t.log; fi; \
	done; exit $$fail

# The C suite against the C++ server AND the C++ pusher: the C runners shell
# out to ./bin/sync_push relative to the cwd, so running them from here drives
# this build. nasty/truncate/symlink/config test C library code, not a peer, so
# they are left out.
interop-c: all port-free
	@$(MAKE) --no-print-directory -C $(C_DIR) tests >/dev/null
	@set -e; \
	mkdir -p sandbox/source sandbox/received $(LOGS); \
	./$(BIN)/sync_server > $(LOGS)/c-server.log 2>&1 & \
	SRV=$$!; trap "kill $$SRV 2>/dev/null || true" EXIT INT TERM; sleep 1; \
	fail=0; \
	for t in $(C_TESTS); do \
	  printf '  c      %-16s ' $$t; \
	  if $(C_DIR)/bin/$$t > $(LOGS)/c-$$t.log 2>&1; then echo PASS; \
	  else echo FAIL; fail=1; sed 's/^/      /' $(LOGS)/c-$$t.log; fi; \
	done; exit $$fail

interop: interop-python interop-c

check: test interop

# Same tree under AddressSanitizer + UBSan, built into bin-asan/ so it never
# mixes objects with the normal build. LeakSanitizer is unavailable on macOS,
# so this catches memory *errors* and undefined behaviour, not leaks.
ASAN_FLAGS := -std=c++23 -O1 -g -fsanitize=address,undefined \
              -fno-omit-frame-pointer -fno-sanitize-recover=undefined \
              -Wall -Wextra -D_DARWIN_C_SOURCE

asan:
	@$(MAKE) --no-print-directory BIN=bin-asan CXXFLAGS="$(ASAN_FLAGS)" \
	  LDFLAGS="-fsanitize=address,undefined" test

clean:
	rm -rf $(BIN) bin-asan

.PRECIOUS: $(BIN)/%.o

.PHONY: all tests test check port-free interop interop-python interop-c asan clean

# Generated by -MMD; absent on a clean tree, which is why this is -include.
-include $(wildcard $(BIN)/*.d)
